pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = "784369107852"
        AWS_REGION     = "ap-south-1"
        ECR_REPO       = "auth-service"
        IMAGE_TAG      = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Application') {
            steps {
                dir('backend_java/auth-service') {
                    // This forces Maven to use the Java 21 version installed on the machine
                    withEnv(["JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64"]) {
                        sh 'mvn clean package -DskipTests'
                    }
                }
            }
        }
    }
}
