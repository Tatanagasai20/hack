pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = '784369107852'
        AWS_REGION     = 'ap-south-1'
        ECR_REPO       = 'alert-service'
        NAMESPACE      = 'hackathon'
        IMAGE_TAG      = "v${BUILD_NUMBER}"
        ECR_URL        = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    }

    stages {

        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Build Maven') {
            steps {
                dir('backend_java/alert-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('backend_java/alert-service') {
                    sh """
                    docker build -t ${ECR_REPO}:${IMAGE_TAG} .
                    """
                }
            }
        }

        stage('Login to ECR') {
            steps {
                sh """
                aws ecr get-login-password --region ${AWS_REGION} | \
                docker login --username AWS --password-stdin ${ECR_URL}
                """
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh """
                docker tag ${ECR_REPO}:${IMAGE_TAG} ${ECR_URL}/${ECR_REPO}:${IMAGE_TAG}
                docker push ${ECR_URL}/${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh """
                # Apply DB (PVC already works - safe to re-apply)
                kubectl apply -n ${NAMESPACE} -f backend_java/database/mysql-secret.yaml
                kubectl apply -n ${NAMESPACE} -f backend_java/database/mysql-pvc.yaml
                kubectl apply -n ${NAMESPACE} -f backend_java/database/mysql-deployment.yaml
                kubectl apply -n ${NAMESPACE} -f backend_java/database/mysql-service.yaml

                # Apply service (safe)
                kubectl apply -n ${NAMESPACE} -f backend_java/k8s/alert-service/service.yaml

                # UPDATE deployment image (IMPORTANT PART)
                kubectl set image deployment/alert-service \
                alert-service=${ECR_URL}/${ECR_REPO}:${IMAGE_TAG} \
                -n ${NAMESPACE}

                # Wait for rollout
                kubectl rollout status deployment/alert-service -n ${NAMESPACE}
                """
            }
        }
    }

    post {
        success {
            echo "✅ Deployment successful: ${IMAGE_TAG}"
        }

        failure {
            echo "❌ Deployment failed"
        }
    }
}
